 "paragraphs": [
  {
   "sw": "Jana Juma alisafiri kwa basi. Alitaka kutembelea rafiki yake mjini.",
   "de": "Gestern reiste Juma mit dem Bus. Er wollte seinen Freund in der Stadt besuchen."
  },
  {
   "sw": "Basi liliondoka mapema asubuhi kutoka stesheni.",
   "de": "Der Bus fuhr früh am Morgen vom Bahnhof ab."
  },
  {
   "sw": "Njiani mvua ilinyesha sana. Barabara ilikuwa mbaya.",
   "de": "Unterwegs regnete es stark. Die Straße war schlecht."
  },
  {
   "sw": "Lakini Juma alifika salama. Rafiki yake alikuwa na furaha.",
   "de": "Aber Juma kam sicher an. Sein Freund freute sich."
  }
 ],
