 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Rehema alifika pwani mchana. Kuna joto sana hapa, na hewa ya maji ni nzuri. Chumba chake ni kidogo, karibu na barabara.",
   "de": "Am Mittag kam Rehema an der Küste an. Hier ist es sehr heiß, und die Luft vom Wasser tut gut. Ihr Zimmer ist klein und liegt nah an der Straße."
  },
  {
   "sw": "Kwanza Rehema alioga na alivaa nguo safi. Alikwenda kwenye duka moja na alinunua matunda. Alikaa karibu na maji na aliona watoto wakicheza.",
   "de": "Zuerst wusch sich Rehema und zog saubere Kleidung an. Sie ging zu einem Laden und kaufte Obst. Sie setzte sich ans Wasser und sah Kindern beim Spielen zu."
  },
  {
   "sw": "Jioni Rehema alipiga simu kwa familia yake. Alihisi vizuri kabisa. Usiku alilala mapema, kwa sababu kesho anataka kuona jua mapema pwani.",
   "de": "Am Abend rief Rehema ihre Familie an. Sie fühlte sich richtig gut. Nachts ging sie früh schlafen, denn morgen will sie die Sonne früh über der Küste sehen."
  }
 ],
