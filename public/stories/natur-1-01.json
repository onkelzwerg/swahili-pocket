 "paragraphs": [
  {
   "sw": "Asubuhi ya leo Neema alikwenda pwani kwa muda kidogo. Jua lilianza kuwaka na ndege wawili walicheza mbele yake.",
   "de": "Heute Vormittag ging Neema für eine kleine Weile an die Küste. Die Sonne fing an zu brennen, und vor ihr spielten zwei Vögel."
  },
  {
   "sw": "Neema alikaa hapa na alikula matunda mawili. Wakati huo mvua ilianza kunyesha na yeye alihisi baridi.",
   "de": "Neema blieb dort sitzen und aß zwei Früchte. In diesem Moment fing es an zu regnen, und ihr wurde kalt."
  },
  {
   "sw": "Neema alikwenda nyumbani haraka. Alipika chai na alipumzika katika chumba chake. Jioni mvua iliisha na Neema aliona jua kubwa mbele ya nyumba yake.",
   "de": "Neema ging schnell nach Hause. Sie kochte Tee und ruhte sich in ihrem Zimmer aus. Am Abend hörte der Regen auf, und Neema sah die große Sonne vor ihrem Haus."
  }
 ],
