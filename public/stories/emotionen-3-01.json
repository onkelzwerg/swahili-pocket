 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Neema alifanya sherehe ndogo nyumbani kwake. Alipika chakula kingi akapanga meza vizuri. Alimngoja rafiki yake Asha kutwa, lakini Asha hakuja.",
   "de": "Neema richtete bei sich zu Hause ein kleines Fest aus. Sie kochte viel Essen und deckte den Tisch schön ein. Den ganzen Tag wartete sie auf ihre Freundin Asha, aber Asha kam nicht."
  },
  {
   "sw": "Neema alikuwa na hasira. Alipopita nyumbani kwa Asha siku iliyofuata, hakusimama na hakusema neno. Aliendelea na safari yake kwa haraka.",
   "de": "Neema war wütend. Als sie am nächsten Tag an Ashas Haus vorbeikam, blieb sie nicht stehen und sagte kein Wort. Sie ging schnellen Schrittes weiter."
  },
  {
   "sw": "Wiki mbili zilipita bila mazungumzo. Neema alihisi vibaya, lakini hakutaka kuwa wa kwanza kuongea. Kila jioni aliketi peke yake mlangoni akingoja, lakini rafiki yake hakuja.",
   "de": "Zwei Wochen vergingen ohne ein Gespräch. Neema fühlte sich schlecht, wollte aber nicht die Erste sein, die redet. Jeden Abend saß sie allein an der Tür und wartete, doch ihre Freundin kam nicht."
  },
  {
   "sw": "Siku moja mama yake alimwambia siri: mama wa Asha alikuwa hospitalini kwa wiki mbili, na Asha alikaa naye kila siku.",
   "de": "Eines Tages verriet ihr die Mutter etwas: Ashas Mutter hatte zwei Wochen im Krankenhaus gelegen, und Asha war jeden Tag bei ihr geblieben."
  },
  {
   "sw": "Neema alitoka nje mara moja akaenda kwa Asha. Aliketi karibu naye akashika mkono wake. „Samahani,“ alisema. „Sikujua.“ Asha alilia kidogo kisha akacheka. Jioni ile waliketi pamoja mlangoni wakazungumza hadi usiku.",
   "de": "Neema lief sofort hinaus und ging zu Asha. Sie setzte sich neben sie und nahm ihre Hand. „Entschuldige“, sagte sie. „Ich wusste es nicht.“ Asha weinte ein wenig und lachte dann. An jenem Abend saßen sie zusammen an der Tür und redeten bis in die Nacht."
  }
 ],
