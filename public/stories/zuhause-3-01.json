 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Jioni ya Jumatano umeme uliisha ghafla, na taa zote zilizima. Amina alikuwa akipika chakula cha jioni, na watoto wake walikuwa wakisoma mezani.",
   "de": "Am Mittwochabend fiel plötzlich der Strom aus, und alle Lampen gingen aus. Amina war gerade beim Kochen, und ihre Kinder saßen lesend am Tisch."
  },
  {
   "sw": "Mtoto mdogo alianza kulia. Amina alimshika mkono akasema, „Hakuna hatari.“ Kisha alitafuta taa ya mafuta katika sanduku la juu.",
   "de": "Das kleine Kind fing an zu weinen. Amina nahm es an der Hand und sagte: „Es ist keine Gefahr.“ Dann suchte sie die Öllampe in der Kiste oben."
  },
  {
   "sw": "Dakika chache baadaye jirani wao aliita mlangoni. „Umeme umeisha mtaa wote,“ alisema. „Nina redio na betri. Twende nje.“",
   "de": "Ein paar Minuten später rief ihr Nachbar an der Tür. „Im ganzen Viertel ist der Strom weg“, sagte er. „Ich habe ein Radio und Batterien. Kommt mit nach draußen.“"
  },
  {
   "sw": "Watu wote wa jengo waliketi nje kwenye kiwanja. Wengine walileta chai, wengine walileta chakula. Redio ilitoa nyimbo za zamani, na watoto walicheza karibu na wazazi wao.",
   "de": "Alle Leute aus dem Haus setzten sich draußen auf den Platz. Die einen brachten Tee, die anderen Essen. Aus dem Radio kamen alte Lieder, und die Kinder spielten neben ihren Eltern."
  },
  {
   "sw": "Saa nne usiku umeme ulirudi, na taa zote ziliwaka tena. Watu walicheka wakaanza kurudi ndani. Amina alisimama nje kwa muda akiangalia nyota. Usiku ule ulikuwa mzuri kuliko siku nyingi.",
   "de": "Um zehn Uhr abends kam der Strom zurück, und alle Lampen brannten wieder. Die Leute lachten und gingen langsam wieder hinein. Amina blieb noch eine Weile draußen stehen und schaute zu den Sternen. Dieser Abend war schöner als viele Tage zuvor."
  }
 ],
