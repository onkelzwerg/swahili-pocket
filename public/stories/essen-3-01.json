 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Jumapili asubuhi Rehema alimwambia kaka yake, „Jioni wageni watakuja. Lazima upike pilau.“ Hamisi alijibu, „Mimi? Sijawahi kupika pilau.“ Lakini Rehema alicheka tu akatoka nje akaenda kazini.",
   "de": "Am Sonntagmorgen sagte Rehema zu ihrem Bruder: „Heute Abend kommen Gäste. Du musst Pilau kochen.“ Hamisi antwortete: „Ich? Ich habe noch nie Pilau gekocht.“ Doch Rehema lachte nur, ging hinaus und fuhr zur Arbeit."
  },
  {
   "sw": "Hamisi alikwenda sokoni akanunua nyama, nyanya, pilipili na mafuta. Aliporudi nyumbani alianza kupika polepole sana. Hakutaka kufanya makosa mbele ya wageni.",
   "de": "Hamisi ging zum Markt und kaufte Fleisch, Tomaten, Pfeffer und Öl. Als er nach Hause kam, fing er ganz langsam zu kochen an. Er wollte vor den Gästen keinen Fehler machen."
  },
  {
   "sw": "Saa mbili baadaye chakula kilikuwa tayari. Hamisi alikula kidogo akakaa chini. Chumvi ilikuwa nyingi sana. „Wageni watacheka,“ alisema.",
   "de": "Zwei Stunden später war das Essen fertig. Hamisi probierte einen Bissen und setzte sich hin. Es war viel zu viel Salz darin. „Die Gäste werden lachen“, sagte er."
  },
  {
   "sw": "Jirani wake aliingia ndani akauliza, „Kuna nini?“ Hamisi alieleza tatizo lake. Mwanamke huyo alicheka akasema, „Ongeza maji na nyanya zaidi, kisha pika tena kwa dakika kumi.“",
   "de": "Seine Nachbarin kam herein und fragte: „Was ist denn los?“ Hamisi erklärte ihr sein Problem. Die Frau lachte und sagte: „Gib mehr Wasser und Tomaten dazu und koch es noch zehn Minuten weiter.“"
  },
  {
   "sw": "Jioni wageni walifika. Walikula pilau yote wakaomba zaidi. Rehema alimtazama kaka yake kwa muda mrefu. „Sasa unajua kupika,“ alisema.",
   "de": "Am Abend kamen die Gäste. Sie aßen das ganze Pilau auf und baten um mehr. Rehema sah ihren Bruder lange an. „Jetzt kannst du kochen“, sagte sie."
  }
 ],
