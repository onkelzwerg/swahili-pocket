 "paragraphs": [
  {
   "sw": "Asubuhi hii gari la Baraka limeharibika. Yeye anataka kwenda kazini kwa basi.",
   "de": "Heute Morgen ist Barakas Auto kaputtgegangen. Er will mit dem Bus zur Arbeit fahren."
  },
  {
   "sw": "Baraka anakaa karibu na barabara. Basi linafika, na yeye anapanda haraka. Anatoa shilingi kwa mtu wa basi.",
   "de": "Baraka sitzt am Straßenrand. Der Bus kommt, und er steigt schnell ein. Dem Mann im Bus zahlt er ein paar Schilling."
  },
  {
   "sw": "Basi linakwenda katika barabara kubwa ya mji. Baraka anafika kazini mapema kidogo. Anahisi vizuri, na mkutano unaanza sasa.",
   "de": "Der Bus fährt über die große Straße der Stadt. Baraka kommt ein bisschen zu früh bei der Arbeit an. Er fühlt sich gut, und das Meeting beginnt gerade."
  }
 ],
