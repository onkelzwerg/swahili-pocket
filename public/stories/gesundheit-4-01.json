 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Kwa wiki tatu jino moja la Bakari lilimuuma. Usiku hakuweza kulala vizuri, na mchana hakuweza kula nyama wala matunda magumu.",
   "de": "Drei Wochen lang schmerzte Bakari ein Zahn. Nachts konnte er nicht gut schlafen, und tagsüber konnte er weder Fleisch noch hartes Obst essen."
  },
  {
   "sw": "Binti yake alimwambia aende hospitali, lakini Bakari alicheka. „Mimi ni mzee wa miaka sitini,“ alisema. „Sitaki kuketi mbele ya daktari kama mtoto.“ Aliendelea kunywa chai ya moto tu, na maumivu yaliongezeka kila siku.",
   "de": "Seine Tochter sagte ihm, er solle ins Krankenhaus gehen, aber Bakari lachte nur. „Ich bin ein Mann von sechzig Jahren“, sagte er. „Ich will nicht wie ein Kind vor einem Arzt sitzen.“ Er trank weiter nur heißen Tee, und die Schmerzen wurden jeden Tag stärker."
  },
  {
   "sw": "Jumatatu asubuhi uso wake ulikuwa mkubwa upande mmoja. Hakuweza kufungua kinywa chake vizuri, na hata maji baridi yalimletea maumivu makali.",
   "de": "Am Montagmorgen war sein Gesicht auf einer Seite dick geschwollen. Er konnte den Mund nicht mehr richtig öffnen, und sogar kaltes Wasser bereitete ihm heftige Schmerzen."
  },
  {
   "sw": "Binti yake hakuuliza tena. Alimpigia simu daktari, akapanga miadi, kisha akamchukua kwa teksi. Bakari hakusema neno njiani.",
   "de": "Seine Tochter fragte nicht noch einmal. Sie rief beim Arzt an, machte einen Termin aus und brachte ihn dann mit dem Taxi hin. Bakari sagte unterwegs kein Wort."
  },
  {
   "sw": "Daktari alipima jino kwa dakika chache tu. „Umechelewa kidogo, lakini bado tunaweza kulitibu,“ alisema. Bakari aliketi kwenye kiti kile bila kusema neno. Alifunga macho yake wakati daktari alipoanza kazi.",
   "de": "Der Arzt untersuchte den Zahn nur ein paar Minuten. „Sie sind ein wenig spät dran, aber wir können ihn noch behandeln“, sagte er. Bakari saß auf jenem Stuhl, ohne ein Wort zu sagen. Er schloss die Augen, als der Arzt zu arbeiten begann."
  },
  {
   "sw": "Nusu saa baadaye Bakari alitoka nje akiwa na vidonge mkononi. Njiani alinunua mswaki mpya. „Ilikuwa rahisi,“ binti yake alisema. Bakari hakujibu, lakini jioni ile alikula nyama kwa mara ya kwanza tangu wiki tatu.",
   "de": "Eine halbe Stunde später kam Bakari mit Tabletten in der Hand heraus. Unterwegs kaufte er eine neue Zahnbürste. „Das war doch einfach“, sagte seine Tochter. Bakari antwortete nicht, aber an jenem Abend aß er zum ersten Mal seit drei Wochen wieder Fleisch."
  }
 ],
