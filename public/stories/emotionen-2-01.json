 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Kila jioni Subira aliangalia kwenye mlango wa nyumba yake. Rafiki yake Halima anakaa mbali, katika nchi ya Kenya. Subira alituma barua kwake, na muda ulipita polepole.",
   "de": "Jeden Abend schaut Subira an der Tür ihres Hauses nach. Ihre Freundin Halima wohnt weit weg, in Kenia. Subira hatte ihr einen Brief geschickt, und die Zeit verging langsam."
  },
  {
   "sw": "Leo Subira alirudi kutoka kazini. Kwenye meza aliona barua nyeupe. Moyo wake ulianza kupiga haraka. Alifungua barua, lakini haikuwa ya Halima. Ilikuwa bili ya umeme.",
   "de": "Heute kam Subira von der Arbeit zurück. Auf dem Tisch sah sie einen weißen Brief. Ihr Herz fing an, schneller zu schlagen. Sie öffnete den Brief, aber er war nicht von Halima. Es war die Stromrechnung."
  },
  {
   "sw": "Subira alikaa chini na alikunywa chai yake polepole. Furaha yake ilipita kabisa.",
   "de": "Subira setzte sich hin und trank langsam ihren Tee. Ihre Freude war ganz verflogen."
  },
  {
   "sw": "Wakati huo jirani yake alifika mlangoni. Alikuwa na barua kwa Subira, na jina la Halima lilikuwa juu. Subira alisoma kila neno polepole, na furaha yake ilirudi.",
   "de": "In dem Moment kam ihre Nachbarin an die Tür. Sie hatte einen Brief für Subira, und oben stand Halimas Name. Subira las jedes Wort langsam, und ihre Freude kam zurück."
  }
 ],
