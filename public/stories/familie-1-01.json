 "paragraphs": [
  {
   "sw": "Juma ana familia kubwa. Wanaishi katika mji mzuri.",
   "de": "Juma hat eine große Familie. Sie leben in einer schönen Stadt."
  },
  {
   "sw": "Kila jioni familia inakula pamoja. Chakula ni kizuri sana.",
   "de": "Jeden Abend isst die Familie zusammen. Das Essen ist sehr gut."
  },
  {
   "sw": "Mtoto anapenda kucheza. Anacheza kila siku kwa saa moja.",
   "de": "Das Kind spielt gern. Es spielt jeden Tag eine Stunde lang."
  },
  {
   "sw": "Usiku familia inalala mapema. Kesho ni siku ya kazi.",
   "de": "Nachts geht die Familie früh schlafen. Morgen ist ein Arbeitstag."
  }
 ],
