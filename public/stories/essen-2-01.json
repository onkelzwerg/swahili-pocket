 "paragraphs": [
  {
   "sw": "Jumamosi mama alikwenda dukani. Alinunua samaki, nyanya na mboga.",
   "de": "Am Samstag ging die Mutter zum Laden. Sie kaufte Fisch, Tomaten und Gemüse."
  },
  {
   "sw": "Nyumbani alikata nyanya kwa kisu. Alipika mchuzi kwa saa moja.",
   "de": "Zu Hause schnitt sie die Tomaten mit dem Messer. Eine Stunde lang kochte sie die Soße."
  },
  {
   "sw": "Watoto walikuwa na furaha. Walisema chakula ni kizuri sana.",
   "de": "Die Kinder freuten sich. Sie sagten, das Essen sei sehr gut."
  },
  {
   "sw": "Jioni familia ilikula pamoja. Mchuzi uliisha haraka.",
   "de": "Am Abend aß die Familie zusammen. Die Soße war schnell aufgegessen."
  }
 ],
