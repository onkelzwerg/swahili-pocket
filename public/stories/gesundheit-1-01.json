 "paragraphs": [
  {
   "sw": "Leo Amina anahisi mbaya. Hataki kula chakula.",
   "de": "Heute fühlt Amina sich schlecht. Sie will nichts essen."
  },
  {
   "sw": "Anakwenda kwa daktari mapema asubuhi.",
   "de": "Sie geht früh am Morgen zum Arzt."
  },
  {
   "sw": "Daktari anatoa dawa nzuri. Amina anahitaji kupumzika siku mbili.",
   "de": "Der Arzt gibt ihr ein gutes Medikament. Amina muss sich zwei Tage ausruhen."
  },
  {
   "sw": "Sasa afya yake ni nzuri. Anaweza kufanya kazi.",
   "de": "Jetzt geht es ihr gut. Sie kann arbeiten."
  }
 ],
