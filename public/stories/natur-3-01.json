 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Katika shule ya Mlimani kulikuwa na kiwanja kikubwa bila mti hata mmoja. Jua lilikuwa kali, na watoto walikaa ndani wakati wa mapumziko.",
   "de": "In der Mlimani-Schule gab es einen großen Hof ohne einen einzigen Baum. Die Sonne brannte, und die Kinder blieben in der Pause drinnen."
  },
  {
   "sw": "Siku moja mwalimu wao alileta miti midogo kumi. „Kila mtoto atapanda mti wake,“ alisema. „Katika miaka mitano tutakuwa na kivuli.“",
   "de": "Eines Tages brachte ihr Lehrer zehn kleine Bäume mit. „Jedes Kind pflanzt seinen eigenen Baum“, sagte er. „In fünf Jahren haben wir Schatten.“"
  },
  {
   "sw": "Watoto walifanya kazi kutwa. Kila mmoja alipanda mti wake akaweka maji chini yake. Jioni mikono yao ilikuwa na uchafu, lakini wote walicheka.",
   "de": "Die Kinder arbeiteten den ganzen Tag. Jedes pflanzte seinen Baum und goss Wasser darauf. Am Abend hatten sie schmutzige Hände, aber alle lachten."
  },
  {
   "sw": "Mvua haikunyesha kwa miezi miwili. Miti mingine ilipoteza majani yake. Watoto walileta maji kila asubuhi kabla ya masomo, na mwalimu wao aliwasaidia.",
   "de": "Zwei Monate lang fiel kein Regen. Einige Bäume verloren ihre Blätter. Die Kinder brachten jeden Morgen vor dem Unterricht Wasser, und ihr Lehrer half ihnen dabei."
  },
  {
   "sw": "Mwaka uliofuata mvua ilinyesha kwa siku nyingi, na miti ilipata nguvu. Leo watoto hukaa chini ya kivuli kila mchana, na kiwanja si kikavu tena.",
   "de": "Im Jahr darauf regnete es viele Tage lang, und die Bäume wurden kräftig. Heute sitzen die Kinder jeden Mittag im Schatten, und der Hof ist nicht mehr ausgedörrt."
  }
 ],
