 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Asubuhi ya Jumatatu Joseph alichukua baisikeli yake. Alitaka kupeleka mzigo kwa jirani yake katika mji. Njia ilikuwa nzuri, na jua lilikuwa juu.",
   "de": "Am Montagmorgen nahm Joseph sein Fahrrad. Er wollte ein Paket zu seinem Nachbarn in der Stadt bringen. Der Weg war schön, und die Sonne stand hoch."
  },
  {
   "sw": "Katika barabara kubwa gurudumu la baisikeli liliharibika. Joseph hakuweza kuendesha. Alitembea polepole na baisikeli yake. Alijua kuwa duka la fundi si mbali.",
   "de": "Auf der großen Straße ging das Rad des Fahrrads kaputt. Joseph konnte nicht mehr fahren. Er ging langsam neben seinem Fahrrad her. Er wusste, dass die Werkstatt nicht weit war."
  },
  {
   "sw": "Mbele ya duka Joseph alikutana na fundi. Fundi aliangalia gurudumu na alisema: „Hii ni kazi rahisi.“ Alitengeneza baisikeli kwa dakika chache. Joseph alilipa shilingi mia mbili.",
   "de": "Vor der Werkstatt traf Joseph den Handwerker. Der Handwerker sah sich das Rad an und sagte: „Das ist leichte Arbeit.“ In wenigen Minuten hatte er das Fahrrad repariert. Joseph zahlte zweihundert Schilling."
  },
  {
   "sw": "Joseph alifika kwa jirani yake mchana. Alitoa mzigo, na jirani alikuwa na furaha. Njia ya kurudi nyumbani ilikuwa rahisi.",
   "de": "Mittags kam Joseph bei seinem Nachbarn an. Er gab das Paket ab, und der Nachbar freute sich. Der Weg zurück nach Hause war leicht."
  }
 ],
