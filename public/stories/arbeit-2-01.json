 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Leo ilikuwa siku ya kwanza ya Bakari kazini. Kampuni ilikuwa katika jengo kubwa karibu na stesheni. Bakari alikuwa na furaha, lakini hakujua kila kitu bado.",
   "de": "Heute war Bakaris erster Arbeitstag. Die Firma lag in einem großen Gebäude nahe beim Bahnhof. Bakari freute sich, aber er kannte noch nicht alles."
  },
  {
   "sw": "Rehema alimwonyesha meza yake na kompyuta moja. Alisema kazi si ngumu sana, lakini lazima kufanya kwa bidii.",
   "de": "Rehema zeigte ihm seinen Tisch und einen Computer. Sie sagte, die Arbeit sei nicht besonders schwierig, man müsse sie aber fleißig machen."
  },
  {
   "sw": "Bakari alianza kazi yake. Alifanya hesabu ya bili kwa saa mbili. Kompyuta iliharibika, lakini Rehema alimsaidia haraka.",
   "de": "Bakari machte sich an die Arbeit. Zwei Stunden lang rechnete er die Belege durch. Der Computer ging kaputt, aber Rehema half ihm schnell."
  },
  {
   "sw": "Jioni Bakari alimaliza kazi yake. Rehema alisema hesabu ni sahihi. Bakari alikwenda nyumbani. Sasa alijua njia yake ya kufanya kazi hii.",
   "de": "Am Abend war Bakari mit seiner Arbeit fertig. Rehema sagte, die Abrechnung stimme genau. Bakari ging nach Hause. Jetzt kannte er seinen Weg, diese Arbeit zu machen."
  }
 ],
