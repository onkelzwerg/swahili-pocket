 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Leo asubuhi Neema alikwenda dukani. Alitaka kununua mkate na maziwa.",
   "de": "Heute Morgen ging Neema zum Laden. Sie wollte Brot und Milch kaufen."
  },
  {
   "sw": "Bei ya mkate ni ghali sana leo. Neema ana pesa kidogo tu.",
   "de": "Der Preis für Brot ist heute sehr hoch. Neema hat nur wenig Geld."
  },
  {
   "sw": "Mtu wa duka alisaidia. Alitoa mkate mmoja kwa bei nzuri.",
   "de": "Der Mann aus dem Laden half. Er gab ihr ein Brot zu einem guten Preis."
  },
  {
   "sw": "Sasa Neema anakwenda nyumbani. Watoto wake wanataka kula.",
   "de": "Jetzt geht Neema nach Hause. Ihre Kinder wollen essen."
  }
 ],
