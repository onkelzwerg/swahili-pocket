 "newLemmas": [],
 "paragraphs": [
  {
   "sw": "Jumamosi mchana Tatu alitaka kusoma kitabu chake kipya. Alitafuta juu ya meza na chini ya meza, lakini hakuona kitabu.",
   "de": "Am Samstagmittag wollte Tatu ihr neues Buch lesen. Sie suchte auf dem Tisch und unter dem Tisch, aber sie sah das Buch nicht."
  },
  {
   "sw": "Mama yake alikuwa ndani. Tatu alisema, „Mama, sioni kitabu changu.“ Mama alijibu, „Jana ulisoma nje, chini ya mti.“",
   "de": "Ihre Mutter war drinnen. Tatu sagte: „Mama, ich sehe mein Buch nicht.“ Die Mutter antwortete: „Gestern hast du draußen gelesen, unter dem Baum.“"
  },
  {
   "sw": "Tatu alikwenda nje. Aliona kitabu chake chini ya mti mkubwa, na majani yalikuwa juu ya kitabu. Alichukua kitabu chake na kurudi ndani.",
   "de": "Tatu ging nach draußen. Sie sah ihr Buch unter dem großen Baum, und Blätter lagen darauf. Sie nahm ihr Buch und ging wieder hinein."
  },
  {
   "sw": "Sasa Tatu alijua mahali pazuri kwa kitabu chake: juu ya meza yake. Alisoma kwa saa moja, na mama alisikiliza hadithi hiyo.",
   "de": "Jetzt kannte Tatu einen guten Platz für ihr Buch: oben auf ihrem Tisch. Sie las eine Stunde lang, und die Mutter hörte der Geschichte zu."
  }
 ],
